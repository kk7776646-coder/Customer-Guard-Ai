function computeChurnPrediction(input, thresholds) {
  let score = 20;
  if (input.contract === 'Month-to-month') score += 35;
  if (input.internet === 'Fiber optic') score += 18;
  if (input.tenure < 12) score += 20 - input.tenure;
  if (input.tickets > 2) score += 12;
  if (input.monthlyCharges > 90) score += 10;
  score = Math.min(98.5, Math.max(3.2, score));
  return { probability: Number(score.toFixed(1)) };
}

