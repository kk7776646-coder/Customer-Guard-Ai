# Clario Environment Variables (.env.example)

# Public Render Backend URL used by the React Vite Frontend
VITE_API_BASE_URL=https://customer-guard-ai.onrender.com

# Server Runtime Configuration
PORT=3000
NODE_ENV=production

# Supabase Authentication & Database Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-key
# Server-side only (never exposed to client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-service-role-key
